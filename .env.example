# =============================================================================
# G7 OS — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com seus valores reais.
# =============================================================================

# Supabase (https://app.supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Service role key (NUNCA exponha no client; usar apenas em server actions admin)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="G7 OS"

# n8n (futuro — endpoint para disparar workflows)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# IA (placeholder — usar quando ligar o módulo de IA)
ANTHROPIC_API_KEY=
